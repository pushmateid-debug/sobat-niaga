{
  "rules": {
    ".read": "auth != null && auth.token.email == 'pushmate.id@gmail.com'",
    ".write": "auth != null && auth.token.email == 'pushmate.id@gmail.com'",

    "users": {
      ".indexOn": ["email", "sellerInfo/isVerifiedSeller", "role", "sellerInfo/isCompetitor"],
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || auth.token.email == 'pushmate.id@gmail.com')",
        ".write": "auth != null && ($uid == auth.uid || auth.token.email == 'pushmate.id@gmail.com')",
        
        "sellerInfo": {
          ".validate": "auth.token.email == 'pushmate.id@gmail.com' || ( (!newData.hasChild('balance') || newData.child('balance').val() == data.child('balance').val()) && (!newData.hasChild('points_event') || newData.child('points_event').val() == data.child('points_event').val()) )"
        }
      }
    },

    "products": {
      ".indexOn": ["sellerId"],
      ".read": true,
      "$productId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'price'])"
      }
    },

    "orders": {
      ".indexOn": ["buyerId", "driverId"],
      ".read": "auth != null", 
      "$orderId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['buyerId', 'totalPrice'])"
      }
    },

    "admin": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'pushmate.id@gmail.com'"
    },

    "chats": {
      ".read": "auth != null && auth.token.email == 'pushmate.id@gmail.com'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || auth.token.email == 'pushmate.id@gmail.com')",
        ".write": "auth != null && ($uid == auth.uid || auth.token.email == 'pushmate.id@gmail.com')"
      }
    },

    "notifications": {
      ".indexOn": ["userId"],
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "drivers_locations": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && ($uid == auth.uid || auth.token.email == 'pushmate.id@gmail.com')"
      }
    },

    "food_delivery_pool": {
      ".read": true,
      ".write": "auth != null"
    },

    "reviews": {
      ".indexOn": ["productId"],
      ".read": true,
      ".write": "auth != null"
    },

    "withdrawals": { 
      ".indexOn": ["sellerId"],
      ".read": "auth != null && (data.child('sellerId').val() == auth.uid || auth.token.email == 'pushmate.id@gmail.com')",
      ".write": "auth != null && (newData.child('sellerId').val() == auth.uid || auth.token.email == 'pushmate.id@gmail.com')"
    },
    "withdrawal_requests": {
      ".indexOn": ["sellerId"],
      ".read": "auth != null && (data.child('sellerId').val() == auth.uid || auth.token.email == 'pushmate.id@gmail.com')",
      ".write": "auth != null && (newData.child('sellerId').val() == auth.uid || auth.token.email == 'pushmate.id@gmail.com')"
    }
  }
}
