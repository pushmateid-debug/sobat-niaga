rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'pushmate.id@gmail.com';
    }

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ─── OJEK ORDERS (NiagaGo) ──────────────────────────────────────────────
    match /ojek_orders/{orderId} {
      // Siapapun yang login bisa baca:
      // - Penumpang lihat pesanan sendiri
      // - Driver lihat semua pending + pesanan yang dia handle
      allow read: if isAuth();

      // Penumpang buat pesanan baru
      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending';

      // Update pesanan:
      // - Admin
      // - Penumpang pembuat pesanan (resource.data.userId == uid())
      // - Driver yang sudah terikat/ditugaskan (resource.data.driverId == uid())
      // - Driver yang mengambil/meng-assign pesanan langsung ke dirinya
      // - Driver yang mengirim penawaran (menambahkan ke offers) saat pesanan masih pending
      // - Driver yang menandai pesanan selesai / driverCredited saat pesanan sedang berjalan atau diselesaikan
      allow update: if isAuth() && (
        isAdmin()
        || resource.data.userId == uid()
        || resource.data.driverId == uid()
        || (
          resource.data.driverId == null
          && request.resource.data.driverId == uid()
        )
        // Driver mengirim penawaran (offer) pada pesanan berstatus pending
        || (
          resource.data.status == 'pending'
        )
        // Driver menyelesaikan perjalanan atau mencatat pencairan driverCredited
        || (
          request.resource.data.driverId == uid()
        )
      );

      // Hanya admin yang bisa hapus (tidak dipakai oleh user biasa)
      allow delete: if isAdmin();
    }

    // ─── DRIVER REGISTRATIONS ────────────────────────────────────────────────
    match /driver_registrations/{regId} {
      // User baca registrasi miliknya, admin baca semua
      allow read: if isAuth() && (
        isAdmin()
        || resource.data.userId == uid()
      );

      // User buat pendaftaran baru untuk dirinya sendiri
      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending';

      // Hanya admin yang bisa update (approve/reject)
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ─── NIAGA VIDEO REELS ──────────────────────────────────────────────────
    match /niaga_reels/{videoId} {
      // Reels are public content; signed-in users can post their own video.
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.shares == 0
        && request.resource.data.taggedProducts is list;

      // Owners can manage their own reel. Other signed-in users can only
      // adjust the public like/comment counters by one at a time.
      allow update: if isAuth() && (
        resource.data.userId == uid()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && request.resource.data.likes >= 0
          && (
            request.resource.data.likes == resource.data.likes + 1
            || request.resource.data.likes == resource.data.likes - 1
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount is int
          && (
            (!resource.data.keys().hasAny(['commentsCount']) && request.resource.data.commentsCount == 1)
            || (
              resource.data.commentsCount is int
              && request.resource.data.commentsCount == resource.data.commentsCount + 1
            )
          )
        )
      );
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == uid());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.userId == uid()
          && request.resource.data.videoId == videoId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if isAdmin() || (isAuth() && resource.data.userId == uid());
      }
    }

    // ─── USERS (Firestore) ───────────────────────────────────────────────────
    // Digunakan untuk menyimpan FCM token dan data profil tambahan
    match /users/{userId} {
      // User hanya bisa baca/tulis dokumen miliknya sendiri; admin bisa semua
      allow read: if isAuth() && (uid() == userId || isAdmin());
      allow write: if isAuth() && (uid() == userId || isAdmin());
    }

    // ─── NIAGA LIVE (uji WebRTC langsung antar-browser) ─────────────────────
    match /live_streams/{streamId} {
      // Daftar siaran aktif dapat dilihat oleh pengguna yang sudah login.
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.hostId == uid()
        && request.resource.data.status == 'live'
        && request.resource.data.sellerName is string
        && request.resource.data.description is string
        && request.resource.data.viewerLimit == 2;
      allow update: if isAuth()
        && resource.data.hostId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
        && request.resource.data.status == 'ended';
      allow delete: if isAuth() && resource.data.hostId == uid();

      match /viewers/{viewerId} {
        function isStreamHost() {
          return isAuth()
            && get(/databases/$(database)/documents/live_streams/$(streamId)).data.hostId == uid();
        }
        function isThisViewer() {
          return isAuth() && resource.data.userId == uid();
        }

        allow read: if isStreamHost() || isThisViewer();
        allow create: if isAuth()
          && request.resource.data.userId == uid()
          && request.resource.data.status == 'waiting'
          && request.resource.data.offer is map;
        allow update: if isStreamHost()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status'])
          || isThisViewer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'leftAt']);
        allow delete: if isStreamHost() || isThisViewer();

        match /callerCandidates/{candidateId} {
          function ownsViewerRequest() {
            return isAuth()
              && get(/databases/$(database)/documents/live_streams/$(streamId)/viewers/$(viewerId)).data.userId == uid();
          }
          function ownsLiveSession() {
            return isAuth()
              && get(/databases/$(database)/documents/live_streams/$(streamId)).data.hostId == uid();
          }
          allow create: if ownsViewerRequest();
          allow read: if ownsViewerRequest() || ownsLiveSession();
          allow update, delete: if false;
        }

        match /calleeCandidates/{candidateId} {
          function ownsViewerRequest() {
            return isAuth()
              && get(/databases/$(database)/documents/live_streams/$(streamId)/viewers/$(viewerId)).data.userId == uid();
          }
          function ownsLiveSession() {
            return isAuth()
              && get(/databases/$(database)/documents/live_streams/$(streamId)).data.hostId == uid();
          }
          allow create: if ownsLiveSession();
          allow read: if ownsViewerRequest() || ownsLiveSession();
          allow update, delete: if false;
        }
      }
    }

    // ─── SEMUA KOLEKSI LAIN (fallback: hanya admin) ─────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
